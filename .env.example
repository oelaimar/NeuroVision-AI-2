# NeuroVision AI: copy to .env and fill in. Never commit .env (it is in .gitignore).
# Rules: no spaces around "=", no quotes needed, comments on their own line.
# Python scripts load this file with python-dotenv; setup.sh loads it with bash.

# ── Kaggle (dataset download): choose ONE option ───────────────────────────────
# Option A: new API token (starts with KGAT_)
KAGGLE_API_TOKEN=your_token_here
# Option B: legacy credentials from kaggle.json (uncomment both lines)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# Kaggle dataset to download (only change it if the name differs)
SLUG=ahmedsorour1/mri-for-brain-tumor-with-bounding-boxes

# ── Project location ──────────────────────────────────────────────────────────
# Absolute path of the project folder. Leave commented to auto-detect.
# PROJECT_ROOT=/home/user/neurovision-part3

# ── MLflow ────────────────────────────────────────────────────────────────────
# Address of the MLflow server (start it with the mlflow server command)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# ── Model served by the API and promoted by the pipeline ──────────────────────
MODEL_NAME=neurovision-yolov8
MODEL_ALIAS=champion

# ── API (FastAPI) ─────────────────────────────────────────────────────────────
# Largest image accepted by POST /predict, in megabytes
MAX_UPLOAD_MB=10

# ── Streamlit ─────────────────────────────────────────────────────────────────
# Address of the FastAPI service the interface calls
API_URL=http://localhost:8000

# ── Airflow pipeline ──────────────────────────────────────────────────────────
# A new model replaces the champion only if its recall is higher AND its mAP@0.5
# does not drop by more than this value
MAX_MAP_DROP=0.05
# Python of the PROJECT environment (the one with torch), found with "which python"
# BEFORE activating the Airflow venv. Needed by the DAG.
# PROJECT_PYTHON=/opt/conda/bin/python
